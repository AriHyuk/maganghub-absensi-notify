# Bearer Token dari header Authorization (tanpa kata 'Bearer ', diawali eyJ...)
AUTH_TOKEN=

# Participant ID MagangHub kamu (dapat dari URL /api/v1/attendances)
PARTICIPANT_ID=57aaeb80-9724-4ecd-a89e-e7ad2abbf8ca

# Cookie browser (termasuk cf_clearance, acw_tc, monev_refresh_token)
COOKIE=

# Telegram Bot Token (dari @BotFather di Telegram)
TG_TOKEN=

# Telegram Chat ID (user ID kamu dari @userinfobot)
TG_CHAT_ID=

# Google Gemini API Key (dari Google AI Studio untuk AI Jurnal Generator)
GEMINI_API_KEY=

# OpenRouter API Key (opsional jika ingin model alternatif OpenRouter)
OPENROUTER_API_KEY=

# OpenRouter Model (opsional, default: meta-llama/llama-3.3-70b-instruct:free atau qwen/qwen3.8-27b:free)
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Interval pengecekan dalam detik (untuk mode lokal polling, default: 60)
CHECK_INTERVAL_SECONDS=60
