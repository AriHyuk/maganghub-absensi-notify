# Bearer Token dari header Authorization (tanpa kata 'Bearer ', diawali eyJ...)
AUTH_TOKEN=

# Participant ID MagangHub kamu
PARTICIPANT_ID=57aaeb80-9724-4ecd-a89e-e7ad2abbf8ca

# Cookie browser (opsional, untuk kelengkapan header)
COOKIE=

# Telegram Bot Token (dari @BotFather di Telegram)
TG_TOKEN=

# Telegram Chat ID (user ID kamu)
TG_CHAT_ID=

# Google Gemini API Key (opsional, dari Google AI Studio untuk AI Jurnal Generator)
GEMINI_API_KEY=

# Interval pengecekan dalam detik (untuk mode lokal polling, default: 60)
CHECK_INTERVAL_SECONDS=60
