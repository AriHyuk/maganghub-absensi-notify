{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/webhook"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "*/30 1-11 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "41 13 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "42 13 * * *"
    }
  ]
}
